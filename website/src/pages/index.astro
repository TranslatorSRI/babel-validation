---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.vue';
---

<Layout title="Babel Validation" description="Daily validation results for NodeNorm and NameRes across all Translator environments.">
	<main>
		<h1>Babel Validation</h1>
		<p>
			<a href="https://github.com/NCATSTranslator/Babel">Babel</a> generates the datasets of
			interrelated identifiers behind <a href="https://github.com/NCATSTranslator/NodeNormalization">Node Normalization</a>
			and <a href="https://github.com/NCATSTranslator/NameResolution">Name Resolution</a>. This dashboard shows the
			results of running the <a href="https://github.com/TranslatorSRI/babel-validation">babel-validation</a> test
			suite daily against every deployment environment. Because test expectations are pinned to the environment where
			a new Babel version lands first, environments are not expected to all be green — the point is to see
			<em>which</em> issues are visible in <em>which</em> environment. See also the
			<a href="./trends/">run history</a>.
		</p>

		<Dashboard client:only="vue" dataUrl={import.meta.env.BASE_URL + 'data/report.json'} />
	</main>
</Layout>
