---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard.vue';
---

<Layout
  title="Babel Validation"
  description="Daily validation results for NodeNorm and NameRes across all Translator environments."
  active="dashboard"
>
  <h1 class="h3 mt-4 mb-3">Babel Validation</h1>

  <div class="card mb-4">
    <div class="card-body">
      <p class="mb-0">
        <a href="https://github.com/NCATSTranslator/Babel">Babel</a> generates the datasets of
        interrelated identifiers behind <a href="https://github.com/NCATSTranslator/NodeNormalization"
          >Node Normalization</a
        >
        and <a href="https://github.com/NCATSTranslator/NameResolution">Name Resolution</a>. This
        dashboard shows the results of running the
        <a href="https://github.com/TranslatorSRI/babel-validation">babel-validation</a> test suite
        daily against every deployment environment. Because test expectations are pinned to the
        environment where a new Babel version lands first, environments are not expected to all be
        green — the point is to see <em>which</em> issues are visible in <em>which</em> environment.
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <Dashboard client:only="vue" dataUrl={import.meta.env.BASE_URL + 'data/report.json'} />
    </div>
  </div>
</Layout>
