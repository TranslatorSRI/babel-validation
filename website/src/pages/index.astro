---
import Layout from '../layouts/Layout.astro';
import Overview from '../components/Overview.vue';
---

<Layout
  title="Babel Validation"
  description="Daily validation results for NodeNorm and NameRes across all Translator environments."
  active="dashboard"
>
  <h1 class="h3 mt-4 mb-2">Babel Validation</h1>
  <p class="text-body-secondary mb-4" style="max-width: 60rem">
    <a href="https://github.com/NCATSTranslator/Babel">Babel</a> generates the datasets of
    interrelated identifiers behind <a href="https://github.com/NCATSTranslator/NodeNormalization"
      >Node Normalization</a
    > and <a href="https://github.com/NCATSTranslator/NameResolution">Name Resolution</a>. This
    dashboard runs the <a href="https://github.com/TranslatorSRI/babel-validation">babel-validation</a
    > test suite daily against every deployment environment. Because test expectations are pinned to
    the environment where a new Babel version lands first, environments are not expected to all be
    green — the point is to see <em>which</em> issues are visible in <em>which</em> environment.
  </p>

  <Overview
    client:only="vue"
    dataUrl={import.meta.env.BASE_URL + 'data/report.json'}
    resultsUrl={import.meta.env.BASE_URL + 'results/'}
  />
</Layout>
