---
import Layout from '../../layouts/Layout.astro';
import Trends from '../../components/Trends.vue';
---

<Layout
  title="Babel Validation: run history"
  description="Babel versions, database sizes and test counts per environment over time."
  active="history"
>
  <h1 class="h3 mt-4 mb-3">Run history</h1>

  <div class="card">
    <div class="card-header">
      One row per daily validation run: Babel and NameRes versions, database sizes, NameRes p95
      latency and test counts for each environment.
    </div>
    <div class="card-body">
      <Trends client:only="vue" dataUrl={import.meta.env.BASE_URL + 'data/history.jsonl'} />
    </div>
  </div>
</Layout>
