---
import Layout from '../../layouts/Layout.astro';
import Trends from '../../components/Trends.vue';
---

<Layout title="Babel Validation: run history" description="Babel versions, database sizes and test counts per environment over time.">
	<main>
		<h1>Run history</h1>
		<p>
			One row per daily validation run: Babel and NameRes versions, database sizes, NameRes p95 latency and test
			counts for each environment. Back to the <a href="./">latest results</a>.
		</p>

		<Trends client:only="vue" dataUrl={import.meta.env.BASE_URL + 'data/history.jsonl'} />
	</main>
</Layout>
